POSTGRES_DB=telly_tracker
POSTGRES_USER=telly
POSTGRES_PASSWORD=local-telly-password
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=10
JWT_SECRET=replace-with-at-least-32-random-characters
# Encrypts SMTP credentials stored by the setup/admin screens and user TOTP secrets. Keep stable.
SETTINGS_ENCRYPTION_KEY=replace-with-a-separate-32-character-secret
# Comma-separated email addresses promoted to administrator when they register or sign in.
ADMIN_EMAILS=
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
# Optional externally reachable origin used only for ICS subscription and event links.
# Example: https://telly.example.com
CALENDAR_PUBLIC_URL=
DEMO_SEED_DATA=false

# Optional deployment-managed SMTP. Leave SMTP_ENABLED blank to configure email in the UI.
# When SMTP_ENABLED is true or false, all SMTP values are read from the environment and the UI is read-only.
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Telly Tracker
SMTP_FROM_EMAIL=

# Published application image. Pin to a release or immutable sha-* tag in production.
APP_IMAGE=ghcr.io/thetxeagle/the-telly-tracker:v0.1.0

# Media metadata providers
# Obtain a TMDB API Read Access Token from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# The public TVmaze API does not require a token.
TVMAZE_API_BASE_URL=https://api.tvmaze.com
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_RETRIES=2
PROVIDER_SEARCH_CACHE_TTL_MS=300000
PROVIDER_REFRESH_INTERVAL_MS=21600000
PROVIDER_REFRESH_BATCH_SIZE=25
